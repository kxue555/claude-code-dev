{
  "mcpServers": {
    "lark-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@larksuiteoapi/lark-mcp",
        "mcp",
        "-a",
        "${env:FEISHU_APP_ID}",
        "-s",
        "${env:FEISHU_APP_SECRET}",
        "--oauth",
        "--token-mode",
        "user_access_token"
      ]
    }
  }
}
